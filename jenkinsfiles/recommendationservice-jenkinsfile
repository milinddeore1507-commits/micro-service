pipeline {
    agent any

    stages {

        stage('Cleaning Workspace') {
            steps {
                cleanWs()
            }
        }

        stage('Checkout from Git') {
            steps {
                git branch: 'master',
                    url: 'https://github.com/milinddeore1507-commits/micro-service.git'
            }
        }

        stage('Docker Image Build') {
            steps {
                script {
                    dir('src/recommendationservice') {
                        sh 'docker system prune -f'
                        sh 'docker container prune -f'
                        sh 'docker build -t recommendationservice .'
                    }
                }
            }
        }

       

        stage('ECR Image Pushing') {
            steps {
                script {
                    sh '''
                        # Login to AWS ECR
                        aws ecr get-login-password --region ap-south-1 | \
                        docker login \
                        --username AWS \
                        --password-stdin 776163183253.dkr.ecr.ap-south-1.amazonaws.com

                        # Tag Docker image
                        docker tag recommendationservice:latest \
                        776163183253.dkr.ecr.ap-south-1.amazonaws.com/recommendationservice:${BUILD_NUMBER}

                        # Push Docker image
                        docker push \
                        776163183253.dkr.ecr.ap-south-1.amazonaws.com/recommendationservice:${BUILD_NUMBER}
                    '''
                }
            }
        }

        stage('Update Deployment file') {
            environment {
                GIT_REPO_NAME = "micro-service"
                GIT_EMAIL = "milinddeore1507@gmail.com"
                GIT_USER_NAME = "milinddeore1507-commits"
                IMAGE_NAME = "recommendationservice"
                REPO_URL = "776163183253.dkr.ecr.ap-south-1.amazonaws.com/recommendationservice"
                YAML_FILE = "recommendationservice.yaml"
            }

            steps {
                dir('kubernetes-files') {
                    withCredentials([
                        string(
                            credentialsId: 'git-tokan',
                            variable: 'git_token'
                        )
                    ]) {
                        sh '''
                            git config user.email "${GIT_EMAIL}"
                            git config user.name "${GIT_USER_NAME}"

                            echo "Build Number: ${BUILD_NUMBER}"

                            # Update image in Kubernetes YAML
                            sed -i "s#image:.*#image: ${REPO_URL}:${BUILD_NUMBER}#g" ${YAML_FILE}

                            # Add only the deployment file
                            git add ${YAML_FILE}

                            # Commit and push only if changes exist
                            if git diff --cached --quiet; then
                                echo "No changes to commit."
                            else
                                git commit -m "Update ${IMAGE_NAME} Image to version ${BUILD_NUMBER}"

                                git push \
                                https://${git_token}@github.com/${GIT_USER_NAME}/${GIT_REPO_NAME}.git \
                                HEAD:master
                            fi
                        '''
                    }
                }
            }
        }
    }
}
